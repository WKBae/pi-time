{
  "name": "pi-time",
  "version": "0.1.0",
  "description": "Task timing, token usage, and cost summaries for Pi",
  "type": "module",
  "license": "MIT",
  "author": "William K. Bae",
  "homepage": "https://github.com/WKBae/pi-time#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WKBae/pi-time.git"
  },
  "bugs": {
    "url": "https://github.com/WKBae/pi-time/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "time",
    "usage"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/time/index.ts"
    ]
  },
  "files": [
    "extensions",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3"
  }
}
